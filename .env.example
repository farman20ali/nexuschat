# ==============================================================================
# NexusChat Server Configuration Template (.env)
# ==============================================================================
# Copy this file to .env on the server machine.
# The client never reads these values and never connects directly to PostgreSQL.

# --- Database Connection (PostgreSQL) ---
CHAT_DB_HOST=localhost
CHAT_DB_PORT=5433
CHAT_DB_NAME=tkinter
CHAT_DB_USER=postgres
CHAT_DB_PASSWORD=change-me

# --- Networking Ports ---
# TCP port for client chat connections
CHAT_TCP_PORT=8082
# UDP port used for LAN auto-discovery broadcasts
CHAT_DISCOVERY_PORT=8083

# --- Server Storage Paths ---
# If omitted, defaults to OS-standard user directories:
# Windows: %LOCALAPPDATA%\NexusChat\data\files
# Linux/macOS: ~/.local/share/nexuschat/data/files
CHAT_DATA_DIR=./data
CHAT_FILE_DIR=./data/files

# --- Security & Administration ---
# Initial default password assigned to root 'admin' user on first database migration
NEXUS_ADMIN_PASSWORD=admin123
# Secret key used for signing HS256 JWT tokens (change for production deployments!)
NEXUS_JWT_SECRET=nexuschat_secret_key_change_in_production_2026
# Optional emergency recovery key for resetting root 'admin' account
NEXUS_MASTER_KEY=master_recovery_key_123

